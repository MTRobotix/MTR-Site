---
import Base from '../../layouts/Base.astro';
import ProductHero from '../../components/ProductHero.astro';
import ProductDetails from '../../components/ProductDetails.astro';
import { products, type Product } from '../../data/products';
import { localPath, type Locale } from '../../data/i18n';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
  locale?: Locale;
}

const { product, locale = 'en' } = Astro.props;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MTRobotics',
  foundingDate: '2019',
  location: ['Rotterdam', 'Stuttgart', 'Monterrey'],
};
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.nav,
  description: product.blurb,
  brand: { '@type': 'Brand', name: 'MTRobotics' },
  additionalProperty: product.specs.map((spec) => ({
    '@type': 'PropertyValue',
    name: spec.label,
    value: `${spec.value}${spec.unit ? ` ${spec.unit}` : ''}`,
  })),
};
---

<Base
  title={`${product.nav} — MTRobotics`}
  description={`${product.title} ${product.blurb}`}
  currentPath={localPath(locale, `/solutions/${product.slug}`)}
  locale={locale}
  jsonLd={[organization, productSchema]}
>
  <article class="product-page">
    <ProductHero product={product} locale={locale} />
    <ProductDetails product={product} locale={locale} />
  </article>
</Base>
