---
import Base from '../layouts/Base.astro';
import CornerMarks from '../components/CornerMarks.astro';
import { demoContent, demoContentVi } from '../data/site';
import { localPath, type Locale } from '../data/i18n';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const content = locale === 'vi' ? demoContentVi : demoContent;
const formCopy = locale === 'vi' ? {
  name: 'Họ và tên', fullName: 'Họ và tên đầy đủ', nameError: 'Vui lòng nhập họ và tên.',
  email: 'Email công việc', emailError: 'Nhập email có ký hiệu @ và tên miền.', emailWarning: 'Địa chỉ công ty giúp chúng tôi phân loại yêu cầu. Địa chỉ này vẫn được chấp nhận.',
  company: 'Công ty', companyError: 'Vui lòng nhập công ty.', location: 'Địa điểm nhà máy', locationPlaceholder: 'Thành phố, quốc gia',
  scope: 'Bạn đang xem xét vấn đề nào?', scopes: ['Kiểm tra', 'Đội AMR', 'Cả hai', 'Chưa xác định'], scopeError: 'Chọn phạm vi khảo sát.',
  timeline: 'Thời gian dự kiến', timelines: ['Quý này', '6 tháng tới', 'Đang tìm hiểu'],
  details: 'Mô tả dây chuyền', detailsPlaceholder: 'Chi tiết, chu kỳ, tỷ lệ loại lỗi hiện tại, giới hạn mặt bằng…',
  submit: 'Yêu cầu khảo sát', submitting: 'Đang gửi', alternative: 'Hoặc liên hệ',
  success: 'Đội kỹ thuật sẽ xác nhận lịch làm việc trong một ngày làm việc.', next: 'Các bước tiếp theo',
  error: 'Không thể gửi yêu cầu. Email mtrobotics@gmail.com hoặc gọi 905 924 5498.',
} : {
  name: 'Name', fullName: 'Full name', nameError: 'Name is required.',
  email: 'Work email', emailError: 'Enter an email with an @ sign and a domain.', emailWarning: 'A company address helps us route the survey. This address is still accepted.',
  company: 'Company', companyError: 'Company is required.', location: 'Site location', locationPlaceholder: 'City, country',
  scope: 'What are you looking at?', scopes: ['Inspection', 'AMR fleet', 'Both', 'Not sure yet'], scopeError: 'Select a survey scope.',
  timeline: 'Timeline', timelines: ['This quarter', 'Next 6 months', 'Exploring'],
  details: 'The line, in your words', detailsPlaceholder: 'Parts, cycle time, current reject rate, layout constraints…',
  submit: 'Request the survey', submitting: 'Submitting', alternative: 'Or email',
  success: 'Engineering availability will be confirmed within one working day.', next: 'What happens next',
  error: 'The request could not be sent. Email mtrobotics@gmail.com or call 905 924 5498.',
};
---

<Base
  title={locale === 'vi' ? 'Yêu cầu demo — MTRobotics' : 'Request a demo — MTRobotics'}
  description={locale === 'vi' ? 'Cung cấp dây chuyền, điểm nghẽn đã đo và địa điểm vận hành để yêu cầu khảo sát kỹ thuật.' : 'Bring MTRobotics a production line, its measured constraint, and the site where it runs. Request an engineering survey.'}
  currentPath={localPath(locale, '/request-a-demo')}
  locale={locale}
>
  <div class="demo-layout">
    <section class="form-panel" aria-labelledby="request-title">
      <span class="eyebrow form-kicker" data-request-kicker>{content.kicker}</span>
      <h1 id="request-title" data-request-title>{content.title}</h1>
      <p class="form-intro" data-request-intro>{content.intro}</p>

      <form class="demo-form" id="demo-form" novalidate data-demo-form data-endpoint="" data-submit-state="idle" data-submitting-label={formCopy.submitting} data-submit-label={formCopy.submit} data-error-message={formCopy.error}>
        <p class="form-status" role="alert" tabindex="-1" data-form-status hidden></p>

        <div class="form-grid">
          <div class="field">
            <label for="name">{formCopy.name}</label>
            <input class="input" id="name" name="name" type="text" autocomplete="name" placeholder={formCopy.fullName} required aria-describedby="name-error" />
            <span class="field-message" id="name-error" data-kind="error" hidden>{formCopy.nameError}</span>
          </div>
          <div class="field">
            <label for="email">{formCopy.email}</label>
            <input class="input" id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="name@company.com" required aria-describedby="email-error email-warning" />
            <span class="field-message" id="email-error" data-kind="error" hidden>{formCopy.emailError}</span>
            <span class="field-message warning" id="email-warning" role="status" hidden>{formCopy.emailWarning}</span>
          </div>
          <div class="field">
            <label for="company">{formCopy.company}</label>
            <input class="input" id="company" name="company" type="text" autocomplete="organization" placeholder={formCopy.company} required aria-describedby="company-error" />
            <span class="field-message" id="company-error" data-kind="error" hidden>{formCopy.companyError}</span>
          </div>
          <div class="field">
            <label for="location">{formCopy.location}</label>
            <input class="input" id="location" name="location" type="text" autocomplete="address-level2" placeholder={formCopy.locationPlaceholder} />
          </div>
        </div>

        <fieldset class="field scope-field" data-scope-group aria-describedby="scope-error">
          <legend>{formCopy.scope}</legend>
          <div class="segmented-control">
            {formCopy.scopes.map((scope, index) => (
              <label>
                <input type="radio" name="scope" value={scope} required={index === 0} />
                <span>{scope}</span>
              </label>
            ))}
          </div>
          <span class="field-message" id="scope-error" data-kind="error" hidden>{formCopy.scopeError}</span>
        </fieldset>

        <fieldset class="field timeline-field">
          <legend>{formCopy.timeline}</legend>
          <div class="radio-row">
            {formCopy.timelines.map((timeline, index) => (
              <label class="radio-option">
                <input type="radio" name="timeline" value={timeline} checked={index === 0} />
                <span aria-hidden="true"></span>{timeline}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="field">
          <label for="line-details">{formCopy.details}</label>
          <textarea class="input" id="line-details" name="line-details" placeholder={formCopy.detailsPlaceholder}></textarea>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary blueprint" type="submit">
            <span data-submit-label>{formCopy.submit}</span>
            <CornerMarks />
          </button>
          <span class="contact-alternative">{formCopy.alternative} <a href="mailto:mtrobotics@gmail.com">mtrobotics@gmail.com</a> · <a href="tel:+19059245498">905 924 5498</a></span>
        </div>
      </form>

      <div class="success-panel" data-demo-success aria-live="polite" hidden>
        <p>{formCopy.success}</p>
      </div>
    </section>

    <aside class="next-panel" aria-labelledby="next-heading">
      <h2 class="eyebrow" id="next-heading">{formCopy.next}</h2>
      <ol class="next-steps">
        {content.steps.map((step) => (
          <li>
            <span class="step-number" aria-hidden="true">{step.num}</span>
            <div><h3>{step.title}</h3><p>{step.body}</p></div>
          </li>
        ))}
      </ol>

    </aside>
  </div>
</Base>

<style>
  .demo-layout {
    display: grid;
    min-height: calc(100vh - var(--space-nav-utility-height) - var(--space-nav-main-height));
    grid-template-columns: 7fr 5fr;
    background: var(--color-bg);
  }

  .form-panel,
  .next-panel { padding: clamp(52px, calc(4.0625vw - 26px), 78px) var(--space-page-gutter) 56px; }

  .form-panel { border-right: var(--space-hairline) solid var(--color-divider); }
  .form-kicker { display: block; margin-bottom: 22px; color: var(--color-accent-700); letter-spacing: .2em; }

  .form-panel h1 {
    max-width: 20ch;
    font-size: var(--font-size-display-form);
    letter-spacing: -.025em;
    line-height: 1;
  }

  .form-intro,
  .success-panel > p {
    max-width: 56ch;
    margin-top: 18px;
    color: color-mix(in srgb, var(--color-text) 68%, transparent);
    font-size: var(--font-size-body-md);
    line-height: 1.65;
  }

  .demo-form { margin-top: 36px; }

  .form-status {
    margin-bottom: var(--space-6);
    padding: var(--space-3);
    border: var(--space-hairline) solid var(--color-accent-700);
    color: var(--color-accent-700);
    font-size: var(--font-size-ui);
  }

  .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .scope-field,
  .timeline-field,
  .demo-form > .field { margin-top: 26px; }

  .field-message {
    width: fit-content;
    border-bottom: var(--space-hairline) solid var(--color-accent-700);
    color: var(--color-accent-700);
    font-size: var(--font-size-label-lg);
    line-height: 1.45;
  }

  .field-message.warning {
    border-bottom-color: var(--color-accent-600);
    color: var(--color-accent-700);
  }

  .segmented-control {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: var(--space-hairline) solid var(--color-divider);
  }

  .segmented-control label { position: relative; cursor: pointer; }
  .segmented-control label + label { border-left: var(--space-hairline) solid var(--color-divider); }

  .segmented-control input {
    position: absolute;
    width: var(--space-hairline);
    height: var(--space-hairline);
    opacity: 0;
  }

  .segmented-control span {
    display: grid;
    min-height: 42px;
    place-items: center;
    padding: var(--space-2);
    background: var(--color-surface);
    font-size: var(--font-size-ui);
    line-height: 1.2;
    text-align: center;
    transition: background-color var(--motion-state) var(--motion-ease), color var(--motion-state) var(--motion-ease);
  }

  .segmented-control input:checked + span { background: var(--color-accent-700); color: var(--color-bg); }
  .segmented-control input:focus-visible + span { outline: var(--space-focus-ring) solid var(--color-accent); outline-offset: -2px; }
  .scope-field[aria-invalid='true'] .segmented-control { border-color: var(--color-accent-700); }

  .radio-row { display: flex; flex-wrap: wrap; gap: 26px; }

  .radio-option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    font-size: var(--font-size-input);
  }

  .radio-option input {
    position: absolute;
    width: var(--space-hairline);
    height: var(--space-hairline);
    opacity: 0;
  }

  .radio-option span {
    width: 16px;
    height: 16px;
    border: var(--space-hairline) solid var(--color-divider);
    background: var(--color-surface);
  }

  .radio-option input:checked + span {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: inset 0 0 0 3px var(--color-surface);
  }

  .radio-option input:focus-visible + span { outline: var(--space-focus-ring) solid var(--color-accent); outline-offset: var(--space-focus-offset); }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 26px;
  }

  .contact-alternative { color: color-mix(in srgb, var(--color-text) 68%, transparent); font-size: var(--font-size-small); }
  .contact-alternative a { text-decoration: none; }
  .contact-alternative a:hover { color: var(--color-accent-700); }

  .success-panel { margin-top: 32px; }

  .next-panel {
    display: flex;
    flex-direction: column;
    background: var(--color-accent-900);
    color: var(--color-bg);
  }

  .next-panel > h2 { margin-bottom: 28px; color: var(--color-accent-300); font-size: var(--font-size-label); font-weight: 400; }
  .next-steps { display: grid; list-style: none; }

  .next-steps li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 18px;
    padding-bottom: 26px;
  }

  .step-number {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: var(--space-hairline) solid var(--color-paper-45);
    font-family: var(--font-heading);
    font-size: var(--font-size-label-lg);
    font-weight: var(--font-heading-weight);
    line-height: 1;
  }

  .next-steps h3 { font-size: var(--font-size-heading-xs); }
  .next-steps p { margin-top: var(--space-1); color: var(--color-paper-76); font-size: var(--font-size-body-sm); line-height: 1.6; }

  @media (max-width: 1024px) {
    .demo-layout { grid-template-columns: 1fr; }
    .form-panel { border-right: 0; border-bottom: var(--space-hairline) solid var(--color-divider); }
    .next-panel { min-height: 560px; }
  }

  @media (max-width: 720px) {
    .form-panel,
    .next-panel { padding: 36px var(--space-mobile-gutter); }
    .form-panel h1 { font-size: 44px; }
    .form-grid { grid-template-columns: 1fr; }
    .segmented-control { grid-template-columns: repeat(2, 1fr); }
    .segmented-control label:nth-child(3) { border-top: var(--space-hairline) solid var(--color-divider); border-left: 0; }
    .segmented-control label:nth-child(4) { border-top: var(--space-hairline) solid var(--color-divider); }
    .form-actions { align-items: flex-start; flex-direction: column; }
    .next-panel { min-height: 620px; }
  }
</style>
