---
import ProductPage from '../../solutions/[slug].astro';
import { productsVi, type Product } from '../../../data/products';

export function getStaticPaths() {
  return productsVi.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product; }
const { product } = Astro.props;
---

<ProductPage product={product} locale="vi" />
