---
// Two-column table in a white frame: name | detail. Used for MTR-Q capabilities and MTR-M specifications.
interface Props {
  head: [string, string];
  rows: { name: string; detail: string }[];
}
const { head, rows } = Astro.props;
---

<div class="specs-wrap">
  <table class="specs">
    <thead>
      <tr>
        <th scope="col">{head[0]}</th>
        <th scope="col">{head[1]}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.name}</th>
            <td>{r.detail}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .specs-wrap {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .specs {
    width: 100%;
    border-collapse: collapse;
  }

  .specs th,
  .specs td {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .specs tbody tr:last-child > * {
    border-bottom: 0;
  }

  .specs thead th {
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .specs tbody th {
    width: 32%;
    font-weight: 500;
    white-space: nowrap;
  }

  .specs td {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .specs thead {
      display: none;
    }

    .specs tbody tr {
      display: block;
      padding: var(--space-4) var(--space-5);
      border-bottom: 1px solid var(--color-line);
    }

    .specs tbody tr:last-child {
      border-bottom: 0;
    }

    .specs tbody th,
    .specs td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
      white-space: normal;
    }

    .specs td {
      margin-top: var(--space-1);
    }
  }
</style>
