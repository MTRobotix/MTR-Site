---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="inspection frame">
  <canvas role="img" aria-label={label} data-inspection-line></canvas>
</div>

<script>
  import { mountInspectionLine } from '../scripts/inspection-line';
  document.querySelectorAll<HTMLCanvasElement>('[data-inspection-line]').forEach(mountInspectionLine);
</script>

<style>
  .inspection {
    aspect-ratio: 16 / 10;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
