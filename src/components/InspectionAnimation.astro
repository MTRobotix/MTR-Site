---
// Parts ride the line, the camera scans them, each turns green (pass) or red (defect)
// as it crosses the beam. Decorative: the parent's caption carries the meaning.
// --d = animation offset, --x = resting position when motion is reduced.
const parts = [
  { kind: 'pass', d: '-4.7s', x: '540px', done: true },
  { kind: 'fail', d: '-3.2s', x: '440px', done: true },
  { kind: 'pass', d: '-1.7s', x: '260px', done: false },
  { kind: 'fail', d: '-0.2s', x: '150px', done: false },
];
---

<div class="inspection frame" aria-hidden="true">
  <svg viewBox="0 0 640 200">
    <line x1="20" y1="150" x2="620" y2="150" class="belt" />
    <circle cx="20" cy="150" r="7" class="roller" />
    <circle cx="620" cy="150" r="7" class="roller" />

    <path d="M296 18 h48 l14 20 h-76 z" class="camera" />
    <circle cx="320" cy="44" r="9" class="lens" />
    <line x1="320" y1="53" x2="320" y2="150" class="beam" />

    {
      parts.map((p) => (
        <rect
          x="-40"
          y="122"
          width="28"
          height="28"
          rx="4"
          class:list={['part', `part-${p.kind}`, { done: p.done }]}
          style={`--d:${p.d};--x:${p.x}`}
        />
      ))
    }
  </svg>
</div>

<style>
  .inspection {
    padding: var(--space-5) var(--space-4);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .belt {
    stroke: var(--color-line-strong);
    stroke-width: 2;
  }

  .roller {
    fill: var(--color-surface);
    stroke: var(--color-line-strong);
    stroke-width: 2;
  }

  .camera {
    fill: var(--color-ink);
  }

  .lens {
    fill: var(--color-bg);
    stroke: var(--color-ink);
    stroke-width: 2;
  }

  .beam {
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-dasharray: 3 5;
    animation: pulse 2s var(--ease) infinite;
  }

  .part {
    fill: var(--color-surface);
    stroke: var(--color-line-strong);
    stroke-width: 2;
    animation: 6s linear var(--d) infinite;
  }

  .part-pass {
    animation-name: travel-pass;
  }

  .part-fail {
    animation-name: travel-fail;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* Beam sits at x=320: (320 + 40) / 700 of the trip ≈ 51%. */
  @keyframes travel-pass {
    0% {
      transform: translateX(0);
    }
    50% {
      fill: var(--color-surface);
      stroke: var(--color-line-strong);
    }
    53% {
      fill: var(--color-pass-soft);
      stroke: var(--color-pass);
    }
    100% {
      transform: translateX(700px);
      fill: var(--color-pass-soft);
      stroke: var(--color-pass);
    }
  }

  @keyframes travel-fail {
    0% {
      transform: translateX(0);
    }
    50% {
      fill: var(--color-surface);
      stroke: var(--color-line-strong);
    }
    53% {
      fill: var(--color-fail-soft);
      stroke: var(--color-fail);
    }
    100% {
      transform: translateX(700px);
      fill: var(--color-fail-soft);
      stroke: var(--color-fail);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .part {
      transform: translateX(var(--x));
    }

    .part-pass.done {
      fill: var(--color-pass-soft);
      stroke: var(--color-pass);
    }

    .part-fail.done {
      fill: var(--color-fail-soft);
      stroke: var(--color-fail);
    }
  }
</style>
