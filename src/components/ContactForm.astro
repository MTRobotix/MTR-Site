---
import { Send } from '@lucide/astro';
import { COMPANY, SITE_URL, localPath, type Locale } from '../data/i18n';
import { contact } from '../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = contact[locale];
const mailto = `mailto:${COMPANY.email}`;
// FormSubmit relays the form to the inbox; the first submission sends a one-time activation email.
// The script posts JSON to the AJAX endpoint; if that fails, the form posts normally and FormSubmit
// sends the visitor back to `_next`, where `?sent=1` shows the thank-you message.
const endpoint = `https://formsubmit.co/${COMPANY.email}`;
const next = new URL(`${localPath(locale, 'contact')}?sent=1`, SITE_URL).href;
---

<form class="contact-form" action={endpoint} method="post" data-contact-form data-endpoint={`https://formsubmit.co/ajax/${COMPANY.email}`}>
  <input type="hidden" name="_subject" value={c.formSubject} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={next} />
  <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="row">
    <div class="field">
      <label for="cf-name">{c.formName}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-company">{c.formCompany}</label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" />
    </div>
  </div>
  <div class="field">
    <label for="cf-email">{c.formEmail}</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="cf-message">{c.formMessage}</label>
    <textarea id="cf-message" name="message" rows="6" required aria-describedby="cf-message-hint"></textarea>
    <p id="cf-message-hint" class="hint">{c.formMessageHint}</p>
  </div>
  <button type="submit" class="btn btn-primary" data-submit>
    <span data-label>{c.formSubmit}</span>
    <Send size={16} stroke-width={1.5} aria-hidden="true" />
  </button>
  <p class="status" role="status" aria-live="polite" data-status hidden></p>
  <p class="hint">{c.formNote} <a href={mailto}>{COMPANY.email}</a>.</p>
  <template data-msg-sending>{c.formSending}</template>
  <template data-msg-sent>{c.formSent}</template>
  <template data-msg-error>{c.formError}</template>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const button = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const label = form?.querySelector<HTMLElement>('[data-label]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const msg = (k: string) => form?.querySelector<HTMLTemplateElement>(`[data-msg-${k}]`)?.content.textContent ?? '';

  const show = (state: 'ok' | 'error') => {
    if (!status) return;
    status.textContent = msg(state === 'ok' ? 'sent' : 'error');
    status.dataset.state = state;
    status.hidden = false;
  };

  // Back from FormSubmit's normal post (see `_next`).
  const params = new URLSearchParams(location.search);
  if (form && params.has('sent')) {
    show('ok');
    params.delete('sent');
    const query = params.toString();
    history.replaceState(history.state, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!button || !label || !status) return;
    const idle = label.textContent;
    button.disabled = true;
    label.textContent = msg('sending');
    status.hidden = true;
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || String(data.success) !== 'true') throw new Error(data.message || res.statusText);
      form.reset();
      show('ok');
      button.disabled = false;
      label.textContent = idle;
    } catch {
      // AJAX refused (form not activated yet, blocked request, network): post the form normally.
      // FormSubmit handles it on its own page and returns the visitor to `_next`.
      try {
        HTMLFormElement.prototype.submit.call(form);
      } catch {
        show('error');
        button.disabled = false;
        label.textContent = idle;
      }
    }
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    width: 100%;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    width: 100%;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
  }

  label {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  input,
  textarea {
    width: 100%;
    min-height: var(--hit);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  textarea {
    padding-block: var(--space-3);
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: var(--color-text-faint);
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
    background: var(--color-surface);
  }

  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .status {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 500;
  }

  .status[data-state='ok'] {
    background: rgba(47, 125, 82, 0.1);
    color: var(--color-pass);
  }

  .status[data-state='error'] {
    background: rgba(229, 70, 61, 0.1);
    color: #b3352d;
  }

  .hint {
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
