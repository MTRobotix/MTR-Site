---
import { localPath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  title: string;
  lead: string;
  cta: string;
}
const { locale, title, lead, cta } = Astro.props;
---

<section class="section">
  <div class="shell">
    <div class="cta-band" data-reveal>
      <div>
        <h2>{title}</h2>
        <p class="lead">{lead}</p>
      </div>
      <a class="btn btn-primary" href={localPath(locale, 'contact')}>{cta}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .cta-band div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (max-width: 720px) {
    .cta-band {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
