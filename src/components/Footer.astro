---
import { COMPANY, isShown, localPath, ui, type Locale } from '../data/i18n';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = ui[locale];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <Wordmark size="sm" />
    </div>
    <nav aria-label={copy.footerProducts}>
      <p class="footer-head">{copy.footerProducts}</p>
      <a href={localPath(locale, 'metriq')}>{copy.nav.metriq}</a>
      <a href={localPath(locale, 'amr')}>{copy.nav.amr}</a>
      {isShown('arm') && <a href={localPath(locale, 'arm')}>{copy.nav.arm}</a>}
    </nav>
    <nav aria-label={copy.footerCompany}>
      <p class="footer-head">{copy.footerCompany}</p>
      <a href={localPath(locale, 'about')}>{copy.nav.about}</a>
      <a href={localPath(locale, 'contact')}>{copy.nav.contact}</a>
    </nav>
    <div>
      <p class="footer-head">{copy.footerContact}</p>
      <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
      {COMPANY.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}
      <p class="footer-muted">{COMPANY.locations.map((l) => l.short).join(' · ')}</p>
    </div>
  </div>
  <div class="shell footer-base">
    <p>© {year} {COMPANY.name}. {copy.rights}</p>
  </div>
</footer>

<style>
  /* No top margin: every page ends with a padded section, so a margin here only adds empty space. */
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-soft);
    font-size: var(--text-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
  }

  .footer-grid > * {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-head {
    margin-bottom: var(--space-1);
    color: var(--color-text);
    font-weight: 500;
  }

  .footer-grid a {
    width: fit-content;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-grid a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .footer-muted,
  .footer-base {
    color: var(--color-text-faint);
  }

  .footer-base {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-xs);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
