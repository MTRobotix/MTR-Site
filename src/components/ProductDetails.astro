---
import type { Product } from '../data/products';
import CornerMarks from './CornerMarks.astro';
import { ui, type Locale } from '../data/i18n';

interface Props {
  product: Product;
  locale?: Locale;
}

const { product, locale = 'en' } = Astro.props;
const copy = ui[locale];
---

<section class="spec-plate" id="product-specification" aria-label={`${product.nav} ${copy.measuredSpecifications}`}>
  <div class="spec-grid" data-reveal-grid>
    {product.specs.map((spec) => (
      <div class="spec-cell">
        <span class="spec-label">{spec.label}</span>
        <span class="spec-reading">
          <strong>{spec.value}</strong>
          {spec.unit && <span>{spec.unit}</span>}
        </span>
      </div>
    ))}
  </div>
</section>

<section class="product-details" aria-labelledby="specification-heading" data-reveal>
  <div class="details-grid">
    <div class="table-cell">
      <h2 class="section-label" id="specification-heading">{copy.specification}</h2>
      <table class="table">
        <tbody>
          {product.rows.map((row) => (
            <tr>
              <th scope="row">{row.key}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="figure-cell">
      <figure class:list={['technical-figure', 'blueprint', { duotone: !product.figureImage }]} aria-label={product.figure}>
        {product.figureImage ? (
          <img src={product.figureImage} alt={product.figure} loading="lazy" />
        ) : (
          <div class="figure-placeholder placeholder-stripes">
            <span class="placeholder-label">{product.figure}</span>
          </div>
        )}
        <figcaption>{product.nav} {copy.technicalFigure}</figcaption>
        <CornerMarks />
      </figure>
    </div>
  </div>
</section>

<style>
  .spec-plate {
    border-bottom: var(--space-hairline) solid var(--color-divider);
    background: var(--color-bg);
  }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .spec-cell {
    display: grid;
    gap: 12px;
    padding: 28px 30px 26px var(--space-page-gutter);
    border-right: var(--space-hairline) solid var(--color-divider);
  }

  .spec-cell:last-child { border-right: 0; }

  .spec-label,
  .section-label {
    color: color-mix(in srgb, var(--color-text) 68%, transparent);
    font-family: var(--font-body);
    font-size: var(--font-size-label-xs);
    font-weight: 400;
    letter-spacing: .16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .spec-reading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .spec-reading strong {
    font-family: var(--font-heading);
    font-size: clamp(44px, calc(1.25vw + 20px), 52px);
    font-weight: var(--font-heading-weight);
    letter-spacing: -.02em;
    line-height: 1;
  }

  .spec-reading > span {
    color: var(--color-accent-700);
    font-family: var(--font-heading);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-heading-weight);
  }

  .product-details { background: var(--color-bg); }

  .details-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
  }

  .table-cell,
  .figure-cell {
    padding-block: 38px 46px;
  }

  .table-cell {
    padding-right: 40px;
    padding-left: var(--space-page-gutter);
    border-right: var(--space-hairline) solid var(--color-divider);
  }

  .figure-cell {
    padding-right: var(--space-page-gutter);
    padding-left: 40px;
  }

  .section-label { margin-bottom: 16px; }
  .table { border-top: var(--space-hairline) solid var(--color-divider); }
  .table th { width: 34%; }
  .table td { color: color-mix(in srgb, var(--color-text) 70%, transparent); line-height: 1.5; }

  .technical-figure {
    height: clamp(210px, calc(7.8125vw + 60px), 260px);
    padding: 18px 20px;
    background: var(--color-bg);
  }

  .figure-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 18px 20px 42px;
  }

  .technical-figure img {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .technical-figure figcaption {
    position: absolute;
    z-index: 4;
    right: 20px;
    bottom: 16px;
    left: 20px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    font-size: var(--font-size-label);
    letter-spacing: .12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .figure-placeholder .placeholder-label { position: relative; z-index: 4; color: color-mix(in srgb, var(--color-text) 55%, transparent); }

  @media (max-width: 1024px) {
    .details-grid { grid-template-columns: 1fr; }
    .table-cell {
      padding-right: var(--space-page-gutter);
      border-right: 0;
      border-bottom: var(--space-hairline) solid var(--color-divider);
    }
    .figure-cell { padding-left: var(--space-page-gutter); }
  }

  @media (max-width: 720px) {
    .spec-grid { grid-template-columns: 1fr; }
    .spec-cell {
      padding: 24px var(--space-mobile-gutter);
      border-right: 0;
      border-bottom: var(--space-hairline) solid var(--color-divider);
    }
    .spec-cell:last-child { border-bottom: 0; }
    .table-cell,
    .figure-cell { padding-block: 32px 40px; }
    .technical-figure { height: 230px; }
  }
</style>
