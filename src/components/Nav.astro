---
import { Menu, X } from '@lucide/astro';
import { isShown, localPath, ui, type Locale, type RouteKey } from '../data/i18n';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  page: RouteKey;
}

const { locale, page } = Astro.props;
const copy = ui[locale];
const allLinks: { key: RouteKey; label: string }[] = [
  { key: 'home', label: copy.nav.home },
  { key: 'metriq', label: copy.nav.metriq },
  { key: 'amr', label: copy.nav.amr },
  { key: 'arm', label: copy.nav.arm },
  { key: 'about', label: copy.nav.about },
];
const links = allLinks.filter((l) => isShown(l.key));
---

<header class="site-header" data-site-header>
  <div class="shell header-bar">
    <a href={localPath(locale, 'home')} class="brand" aria-label={copy.homeLabel}>
      <Wordmark collapsible />
    </a>

    <nav class="nav-links" aria-label={copy.primaryNav}>
      {
        links.map((l) => (
          <a href={localPath(locale, l.key)} aria-current={page === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <div class="lang" role="group" aria-label={copy.language}>
        <a href={localPath('en', page)} hreflang="en" lang="en" aria-current={locale === 'en' ? 'true' : undefined} data-lang="en">EN</a>
        <a href={localPath('vi', page)} hreflang="vi" lang="vi" aria-current={locale === 'vi' ? 'true' : undefined} data-lang="vi">VI</a>
      </div>
      <a href={localPath(locale, 'contact')} class="btn btn-primary header-cta" aria-current={page === 'contact' ? 'page' : undefined}>
        {copy.nav.contact}
      </a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="icon-open"><Menu size={22} stroke-width={1.5} aria-hidden="true" /></span>
        <span class="icon-close"><X size={22} stroke-width={1.5} aria-hidden="true" /></span>
        <span class="visually-hidden" data-label-open>{copy.openMenu}</span>
        <span class="visually-hidden" data-label-close hidden>{copy.closeMenu}</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <nav class="shell" aria-label={copy.primaryNav}>
      {
        links.map((l) => (
          <a href={localPath(locale, l.key)} aria-current={page === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={localPath(locale, 'contact')} class="btn btn-primary">{copy.nav.contact}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    /* Stays in place while the page content cross-fades on navigation. */
    view-transition-name: site-header;
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--color-line);
    box-shadow: var(--shadow-sm);
  }

  /* Three columns so the nav stays centred while the wordmark folds to MTR. */
  .header-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-h);
  }

  .header-bar > .header-actions {
    justify-self: end;
  }

  .brand {
    display: inline-flex;
    justify-self: start;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-1);
  }

  .nav-links a {
    position: relative;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-text);
  }

  /* Active page: short underline, no fill. */
  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lang {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }

  .lang a {
    min-width: 2.4rem;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
  }

  .lang a[aria-current='true'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--hit);
    height: var(--hit);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
  }

  .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: inline-flex;
  }

  .icon-open {
    display: inline-flex;
  }

  .mobile-menu {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-3) var(--space-5);
  }

  .mobile-menu a:not(.btn) {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-lead);
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--color-accent);
  }

  .mobile-menu .btn {
    margin-top: var(--space-5);
  }

  @media (max-width: 900px) {
    .header-bar {
      display: flex;
      justify-content: space-between;
    }

    .nav-links,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }
</style>
