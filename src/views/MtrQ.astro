---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import { mtrq } from '../data/content';
import type { Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = mtrq[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="mtrq">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div class="page-hero-copy">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="tagline">{c.tagline}</p>
        <p class="lead">{c.intro}</p>
      </div>
      <figure>
        <div class="frame">
          <img src="/images/mtr-q/mtr-q-cell.webp" alt={c.heroCaption} width="1800" height="1440" fetchpriority="high" />
        </div>
        <figcaption class="caption">{c.heroCaption}</figcaption>
      </figure>
    </div>
    <div class="shell">
      <Stats locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2 class="block-title">{c.specsTitle}</h2>
      <div class="specs-wrap" data-reveal>
        <table class="specs">
          <thead>
            <tr>
              <th scope="col">{c.specsCapability}</th>
              <th scope="col">{c.specsDetail}</th>
            </tr>
          </thead>
          <tbody>
            {
              c.specs.map((s) => (
                <tr>
                  <th scope="row">{s.name}</th>
                  <td>{s.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div data-reveal>
        <h2 class="block-title">{c.whyTitle}</h2>
        <ul class="ticks">
          {c.why.map((w) => <li>{w}</li>)}
        </ul>
      </div>
      <figure data-reveal style="--d:1">
        <h2 class="block-title">{c.practiceTitle}</h2>
        <div class="frame">
          <img src="/images/mtr-q/mtr-q-output.webp" alt={c.practiceAlt} width="1172" height="968" loading="lazy" />
        </div>
        <figcaption class="caption">{c.practiceCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <h2 class="block-title" data-reveal>{c.stepsTitle}</h2>
      <Steps locale={locale} />
    </div>
  </section>

  <CtaBand locale={locale} title={c.ctaTitle} lead={c.ctaLead} cta={c.cta} />
</Base>

<style>
  .specs-wrap {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .specs {
    width: 100%;
    border-collapse: collapse;
  }

  .specs th,
  .specs td {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .specs tbody tr:last-child > * {
    border-bottom: 0;
  }

  .specs thead th {
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .specs tbody th {
    width: 32%;
    font-weight: 500;
    white-space: nowrap;
  }

  .specs td {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .specs thead {
      display: none;
    }

    .specs tbody tr {
      display: block;
      padding: var(--space-4) var(--space-5);
      border-bottom: 1px solid var(--color-line);
    }

    .specs tbody tr:last-child {
      border-bottom: 0;
    }

    .specs tbody th,
    .specs td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
      white-space: normal;
    }

    .specs td {
      margin-top: var(--space-1);
    }
  }
</style>
