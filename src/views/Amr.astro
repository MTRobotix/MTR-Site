---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import RouteAnimation from '../components/RouteAnimation.astro';
import SpecTable from '../components/SpecTable.astro';
import { amr } from '../data/content';
import { ui, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = amr[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="amr" image="/images/amr/amr-render.jpg">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div class="page-hero-copy">
        <p class="kicker">{c.kicker}</p>
        <span class="badge badge-soon">{ui[locale].comingSoon}</span>
        <h1>{c.h1}</h1>
        <p class="tagline">{c.tagline}</p>
        <p class="lead">{c.lead}</p>
      </div>
      <figure>
        <div class="frame">
          <img src="/images/amr/amr-render.webp" alt={c.imageAlt} width="1600" height="1200" fetchpriority="high" />
        </div>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="overview" data-reveal>
        <div>
          <h2 class="block-title">{c.overviewTitle}</h2>
          <p class="lead">{c.overview}</p>
        </div>
        <ul class="ticks">
          {c.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="amr-grid">
        <figure data-reveal>
          <RouteAnimation label={c.routeLabel} />
          <figcaption class="caption">{c.routeCaption}</figcaption>
        </figure>
        <div data-reveal style="--d:1">
          <h2 class="block-title">{c.specsTitle}</h2>
          <SpecTable head={c.specsHead} rows={c.specs.map((s) => ({ name: s.label, detail: s.value }))} />
        </div>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} title={c.ctaTitle} lead={c.ctaLead} cta={c.cta} />
</Base>

<style>
  /* Overview on top; animation beside the specs table below it. The whole block fits one laptop screen. */
  .overview {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: end;
    margin-bottom: var(--space-7);
  }

  .overview .block-title {
    margin-bottom: var(--space-3);
  }

  .amr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  .amr-grid .block-title {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 900px) {
    .overview,
    .amr-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .overview {
      margin-bottom: var(--space-6);
    }
  }
</style>
