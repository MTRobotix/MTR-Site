---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import SpecTable from '../components/SpecTable.astro';
import { metriq } from '../data/content';
import type { Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = metriq[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="metriq">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div class="page-hero-copy">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="tagline">{c.tagline}</p>
        <p class="lead">{c.intro}</p>
      </div>
      <figure>
        <div class="frame">
          <img src="/images/metriq/metriq-cell.webp" alt={c.heroCaption} width="1800" height="1440" fetchpriority="high" />
        </div>
        <figcaption class="caption">{c.heroCaption}</figcaption>
      </figure>
    </div>
    <div class="shell">
      <Stats locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>{c.dashboardTitle}</h2>
        <p class="lead">{c.dashboardLead}</p>
      </div>
      <figure data-reveal>
        <div class="frame">
          <img src="/images/metriq/metriq-dashboard.webp" alt={c.dashboardAlt} width="1440" height="1010" loading="lazy" />
        </div>
        <figcaption class="caption">{c.dashboardCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2 class="block-title">{c.specsTitle}</h2>
      <div data-reveal>
        <SpecTable head={[c.specsCapability, c.specsDetail]} rows={c.specs} />
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head" data-reveal>
        <h2>{c.monitoringTitle}</h2>
        <p class="lead">{c.monitoringLead}</p>
        <ul class="ticks">
          {c.monitoringPoints.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <figure data-reveal>
        <div class="frame">
          <img src="/images/metriq/metriq-monitoring.webp" alt={c.monitoringAlt} width="1440" height="1080" loading="lazy" />
        </div>
        <figcaption class="caption">{c.monitoringCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div data-reveal>
        <h2 class="block-title">{c.whyTitle}</h2>
        <ul class="ticks">
          {c.why.map((w) => <li>{w}</li>)}
        </ul>
      </div>
      <figure data-reveal style="--d:1">
        <h2 class="block-title">{c.practiceTitle}</h2>
        <div class="frame">
          <img src="/images/metriq/metriq-output.webp" alt={c.practiceAlt} width="1172" height="968" loading="lazy" />
        </div>
        <figcaption class="caption">{c.practiceCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <h2 class="block-title" data-reveal>{c.stepsTitle}</h2>
      <Steps locale={locale} />
    </div>
  </section>

  <CtaBand locale={locale} title={c.ctaTitle} lead={c.ctaLead} cta={c.cta} />
</Base>
