---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact } from '../data/content';
import { COMPANY, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = contact[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="contact">
  <section class="page-hero">
    <div class="shell">
      <div class="page-hero-copy narrow">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell contact-grid">
      <div class="panel">
        <h2 class="block-title">{c.formTitle}</h2>
        <ContactForm locale={locale} />
      </div>
      <div class="side">
        <div class="panel">
          <ContactBlock locale={locale} />
          <a class="btn" href={COMPANY.linkedin} rel="noopener" target="_blank">{c.linkedinLabel}</a>
        </div>
        <div class="panel">
          <h2 class="block-title">{c.includeTitle}</h2>
          <ul class="ticks">
            {c.include.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 52rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .panel .block-title {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .panel {
      padding: var(--space-5);
    }
  }
</style>
