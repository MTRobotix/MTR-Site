---
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import { about } from '../data/content';
import { COMPANY, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = about[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="about">
  <section class="page-hero">
    <div class="shell">
      <div class="page-hero-copy narrow">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2 class="block-title">{c.whereTitle}</h2>
      <ul class="places" data-reveal>
        {
          COMPANY.locations.map((l) => (
            <li>
              <span class="place-code">{l.short}</span>
              <span>{l[locale]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <h2 class="block-title">{c.howTitle}</h2>
      <Steps locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div class="founder" data-reveal>
        <p class="kicker">{c.founderKicker}</p>
        <h2>{c.founderName}</h2>
        <p class="role">{c.founderRole}</p>
        <p>{c.founderBody}</p>
        <p class="edu">{c.education}</p>
      </div>
      <div data-reveal>
        <h3 class="block-title">{c.experienceTitle}</h3>
        <dl class="facts">
          {
            c.experience.map((e) => (
              <div>
                <dt>{e.org}</dt>
                <dd>
                  {e.role} <span class="period">· {e.period}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 52rem;
  }

  .places {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .places li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .place-code {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 600;
  }

  .founder {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .founder .kicker {
    margin-bottom: 0;
  }

  .role,
  .edu,
  .period {
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .places {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
