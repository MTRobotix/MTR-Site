---
import { MapPin } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import { about } from '../data/content';
import { COMPANY, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = about[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="about">
  <section class="page-hero">
    <div class="shell">
      <div class="page-hero-copy narrow">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
      </div>
    </div>
  </section>

  <section class="section where">
    <div class="shell where-row" data-reveal>
      <h2 class="kicker">{c.whereTitle}</h2>
      <ul class="places">
        {
          COMPANY.locations.map((l) => (
            <li>
              <MapPin size={16} stroke-width={1.5} aria-hidden="true" />
              {l[locale]}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <h2 class="block-title">{c.howTitle}</h2>
      <Steps locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div class="founder" data-reveal>
        <p class="kicker">{c.founderKicker}</p>
        <h2>{c.founderName}</h2>
        <p class="role">{c.founderRole}</p>
        <p>{c.founderBody}</p>
        <p class="edu">{c.education}</p>
      </div>
      <div data-reveal>
        <h3 class="block-title">{c.journeyTitle}</h3>
        <dl class="facts">
          {
            c.journey.map((e) => (
              <div>
                <dt>{e.org}</dt>
                <dd>
                  {e.role} <span class="period">· {e.period}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 52rem;
  }

  .section.where {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .where-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .where-row .kicker {
    margin: 0;
    font-family: var(--font-body);
  }

  .places {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .places li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
  }

  .places :global(svg) {
    color: var(--color-accent);
  }

  .founder {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .founder .kicker {
    margin-bottom: 0;
  }

  .role,
  .edu,
  .period {
    color: var(--color-text-muted);
  }
</style>
