---
import { ArrowRight, MapPin } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import { about } from '../data/content';
import { COMPANY, localPath, ui, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = about[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="about">
  <section class="page-hero">
    <div class="shell">
      <div class="page-hero-copy narrow">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <h2 data-reveal>{c.storyTitle}</h2>
      <ol class="milestones">
        {
          c.milestones.map((m, i) => (
            <li class:list={['milestone', { 'is-next': 'next' in m && m.next }]} data-reveal style={`--d:${i}`}>
              <p class="kicker">{m.label}</p>
              <h3>{m.title}</h3>
              <p class="milestone-body">{m.body}</p>
              {'photo' in m && m.photo && (
                <div class="frame milestone-photo">
                  <img src={m.photo.src} alt={m.photo.alt} width="1200" height="900" loading="lazy" />
                </div>
              )}
              {'link' in m && m.link && (
                <a class="text-link" href={localPath(locale, m.link)}>
                  {ui[locale].learnMore} <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <h2 class="block-title" data-reveal>{c.howTitle}</h2>
      <Steps locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div class="founder" data-reveal>
        <div class="founder-head">
          <img class="founder-photo" src="/images/about/founder.webp" alt={c.founderPhotoAlt} width="480" height="480" loading="lazy" />
          <div>
            <p class="kicker">{c.founderKicker}</p>
            <h2>{c.founderName}</h2>
            <p class="role">{c.founderRole}</p>
          </div>
        </div>
        <p>{c.founderBody}</p>
        <p class="edu">{c.education}</p>
      </div>
      <div data-reveal style="--d:1">
        <h3 class="block-title">{c.journeyTitle}</h3>
        <dl class="facts">
          {
            c.journey.map((e) => (
              <div>
                <dt>{e.org}</dt>
                <dd>
                  {e.role} <span class="period">· {e.period}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section where">
    <div class="shell where-row" data-reveal>
      <h2 class="kicker">{c.whereTitle}</h2>
      <ul class="places">
        {
          COMPANY.locations.map((l) => (
            <li>
              <MapPin size={16} stroke-width={1.5} aria-hidden="true" />
              {l[locale]}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 52rem;
  }

  /* Vertical milestone line: one dot per step; the line to the next dot draws down as the step reveals. */
  .milestones {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .milestone {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-6);
  }

  .milestone .kicker {
    margin: 0;
  }

  .milestone::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
  }

  .milestone.is-next::before {
    background: var(--color-bg);
  }

  .milestone:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.375rem - 1px);
    top: 1.35rem;
    bottom: calc(-1 * var(--space-6) + 0.3rem);
    width: 2px;
    background: var(--color-line-strong);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-slow) var(--ease) calc(var(--d, 0) * var(--stagger) + 200ms);
  }

  .milestone.is-visible::after {
    transform: none;
  }

  .milestone-body {
    color: var(--color-text-muted);
  }

  .milestone-photo {
    max-width: 28rem;
    margin-top: var(--space-2);
  }

  .section.where {
    padding-block: var(--space-5);
  }

  .where-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .where-row .kicker {
    margin: 0;
    font-family: var(--font-body);
  }

  .places {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .places li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
  }

  .places :global(svg) {
    color: var(--color-accent);
  }

  .founder {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .founder-head {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .founder-head > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .founder-photo {
    flex: none;
    width: 9.5rem;
    height: 9.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .founder .kicker {
    margin-bottom: 0;
  }

  .role,
  .edu,
  .period {
    color: var(--color-text-muted);
  }
</style>
