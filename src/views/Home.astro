---
import { ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import ProductCards from '../components/ProductCards.astro';
import ContactBlock from '../components/ContactBlock.astro';
import InspectionAnimation from '../components/InspectionAnimation.astro';
import { home } from '../data/content';
import { localPath, ui, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = home[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="home">
  <section class="hero" data-hero-pool>
    <div class="pool-field" aria-hidden="true"><canvas data-pool-canvas></canvas></div>
    <span class="pool-reticle" data-pool-reticle aria-hidden="true"><i></i></span>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localPath(locale, 'mtrq')}>{c.ctaPrimary}</a>
          <a class="btn" href={localPath(locale, 'contact')}>{c.ctaSecondary}</a>
        </div>
      </div>
      <figure class="frame hero-media">
        <img src="/images/mtr-q/mtr-q-cell.webp" alt={c.cellAlt} width="1800" height="1440" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="solution">
        <div class="solution-copy" data-reveal>
          <p class="kicker">{c.solutionKicker}</p>
          <h2>{c.solutionTitle}</h2>
          <ul class="ticks">
            {c.solutionPoints.map((p) => <li>{p}</li>)}
          </ul>
          <a class="text-link" href={localPath(locale, 'mtrq')}>
            {ui[locale].learnMore} <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        </div>
        <div data-reveal style="--d:1">
          <InspectionAnimation label={c.animationLabel} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="kicker">{c.productsKicker}</p>
        <h2>{c.productsTitle}</h2>
      </div>
      <ProductCards locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div class="section-head" data-reveal>
        <h2>{c.contactTitle}</h2>
        <p class="lead">{c.contactLead}</p>
      </div>
      <div data-reveal>
        <ContactBlock locale={locale} />
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountHeroPool } from '../scripts/hero-pool';

  // Desktop only: wider than the 900px breakpoint, with a mouse. Phones and tablets get the plain hero.
  const desktop = window.matchMedia('(min-width: 901px) and (hover: hover) and (pointer: fine)');
  const mount = () => document.querySelectorAll<HTMLElement>('[data-hero-pool]').forEach(mountHeroPool);
  if (desktop.matches) mount();
  else {
    const onChange = (e: MediaQueryListEvent) => {
      if (!e.matches) return;
      desktop.removeEventListener('change', onChange);
      mount();
    };
    desktop.addEventListener('change', onChange);
  }
</script>

<style>
  .hero {
    /* --hero-dot-rest must equal --color-bg (#faf9f6) or resting dots show as a grid. */
    --hero-dot-rest: 250, 249, 246;
    --hero-dot-active: 47, 93, 138;
    --hero-reticle: rgba(23, 24, 26, 0.6);

    position: relative;
    overflow: hidden;
    padding-block: var(--space-7) var(--space-8);
    /* Vertical drags still scroll the page; sideways drags play with the field on touch. */
    touch-action: pan-y;
  }

  .hero[data-pointer-active] {
    cursor: none;
  }

  .hero a,
  .hero button {
    cursor: pointer;
  }

  .pool-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .pool-field canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero > .shell {
    position: relative;
    z-index: 3;
  }

  /* Crosshair reticle that replaces the pointer inside the hero. */
  .pool-reticle {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 27px;
    height: 27px;
    border: 1px solid var(--hero-reticle);
    opacity: 0;
    pointer-events: none;
    transform: translate(-100%, -100%);
    transition: opacity var(--dur-fast) var(--ease);
  }

  .hero[data-pointer-active] .pool-reticle {
    opacity: 1;
  }

  .pool-reticle::before,
  .pool-reticle::after {
    content: '';
    position: absolute;
    background: var(--hero-reticle);
  }

  .pool-reticle::before {
    top: 50%;
    left: 7px;
    width: calc(100% - 14px);
    height: 1px;
  }

  .pool-reticle::after {
    top: 7px;
    left: 50%;
    width: 1px;
    height: calc(100% - 14px);
  }

  .pool-reticle i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    background: var(--color-bg);
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: reduce), (max-width: 900px), (hover: none) {
    .hero[data-pointer-active] {
      cursor: auto;
    }

    .pool-field,
    .pool-reticle {
      display: none;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Home hero entrance (overrides the shared rise): each line wipes in left to right, once per load.
     backwards fill so no clip lingers afterwards (keeps focus rings and descenders intact). */
  .hero-copy > * {
    animation: hero-wipe var(--dur-slow) var(--ease) backwards;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: calc(var(--stagger) * 1.5);
  }

  .hero-copy > :nth-child(3) {
    animation-delay: calc(var(--stagger) * 3);
  }

  @keyframes hero-wipe {
    from {
      clip-path: inset(-20% 100% -20% 0);
      transform: translateX(-12px);
      opacity: 0;
    }
    to {
      clip-path: inset(-20% -10% -20% 0);
    }
  }

  .solution {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-7);
    align-items: center;
  }

  .solution-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .solution-copy .kicker {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: var(--space-5);
    }

    .hero-grid,
    .solution {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
