---
import { ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import ProductCards from '../components/ProductCards.astro';
import ContactBlock from '../components/ContactBlock.astro';
import InspectionAnimation from '../components/InspectionAnimation.astro';
import { home } from '../data/content';
import { localPath, ui, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = home[locale];
---

<Base title={c.title} description={c.description} locale={locale} page="home">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localPath(locale, 'mtrq')}>{c.ctaPrimary}</a>
          <a class="btn" href={localPath(locale, 'contact')}>{c.ctaSecondary}</a>
        </div>
      </div>
      <figure class="frame hero-media">
        <img src="/images/mtr-q/mtr-q-cell.webp" alt={c.cellAlt} width="1800" height="1440" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="solution">
        <div class="solution-copy" data-reveal>
          <p class="kicker">{c.solutionKicker}</p>
          <h2>{c.solutionTitle}</h2>
          <ul class="ticks">
            {c.solutionPoints.map((p) => <li>{p}</li>)}
          </ul>
          <a class="text-link" href={localPath(locale, 'mtrq')}>
            {ui[locale].learnMore} <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        </div>
        <div data-reveal style="--d:1">
          <InspectionAnimation label={c.animationLabel} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <p class="kicker">{c.productsKicker}</p>
        <h2>{c.productsTitle}</h2>
      </div>
      <ProductCards locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="shell two-col">
      <div class="section-head" data-reveal>
        <h2>{c.contactTitle}</h2>
        <p class="lead">{c.contactLead}</p>
      </div>
      <div data-reveal>
        <ContactBlock locale={locale} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-8);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Home hero entrance (overrides the shared rise): each line wipes in left to right, once per load.
     backwards fill so no clip lingers afterwards (keeps focus rings and descenders intact). */
  .hero-copy > * {
    animation: hero-wipe var(--dur-slow) var(--ease) backwards;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: calc(var(--stagger) * 1.5);
  }

  .hero-copy > :nth-child(3) {
    animation-delay: calc(var(--stagger) * 3);
  }

  @keyframes hero-wipe {
    from {
      clip-path: inset(-20% 100% -20% 0);
      transform: translateX(-12px);
      opacity: 0;
    }
    to {
      clip-path: inset(-20% -10% -20% 0);
    }
  }

  .solution {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-7);
    align-items: center;
  }

  .solution-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .solution-copy .kicker {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: var(--space-5);
    }

    .hero-grid,
    .solution {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
